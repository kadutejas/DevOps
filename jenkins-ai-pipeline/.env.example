# Copy this file to .env and fill in your values before running docker compose.
#   cp .env.example .env
#
# The Jenkins container reads these variables to authenticate with AWS Bedrock.
# The IAM user / role must have bedrock:InvokeModel permission on
# eu.anthropic.claude-haiku-4-5-20251001-v1:0 in the configured region.

AWS_ACCESS_KEY_ID=your-key-here
AWS_SECRET_ACCESS_KEY=your-secret-here
AWS_REGION=eu-west-1
